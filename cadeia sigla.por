programa
{
    funcao inicio()
    {
        cadeia sigla

        escreva("Digite a sigla da cor (AZ, AM, BR, PR, VR): ")
        leia(sigla)

        se (sigla == "AZ")
        {
            escreva("Azul")
        }
        senao se (sigla == "AM")
        {
            escreva("Amarelo")
        }
        senao se (sigla == "BR")
        {
            escreva("Branco")
        }
        senao se (sigla == "PR")
        {
            escreva("Preto")
        }
        senao se (sigla == "VR")
        {
            escreva("Vermelho")
        }
        senao
        {
            escreva("Sigla inválida")
        }
    }
}
